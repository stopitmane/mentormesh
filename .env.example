# Copy this file to .env.local and fill in your CognoDB Cloud connection details.
# .env.local is gitignored and will never be committed.

# From console.cognodb.com after creating your instance:
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<the password shown once when the instance was created>
